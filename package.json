{
  "name": "dsh-carsi-papers",
  "version": "0.8.2",
  "type": "module",
  "description": "Drive your own browser through the campus CARSI sign-in to search subscribed literature databases and download their full texts.",
  "keywords": [
    "academic",
    "browser",
    "campus-network",
    "carsi",
    "carsi-login",
    "chrome-devtools-protocol",
    "deepseek",
    "dsh",
    "literature",
    "literature-search",
    "paper-search",
    "pdf",
    "plugin",
    "shibboleth",
    "cnki",
    "wanfang",
    "知网",
    "万方",
    "ieee",
    "springer",
    "sciencedirect",
    "gb7714",
    "gb-t-7714",
    "zotero",
    "bibtex",
    "crossref",
    "reference-audit",
    "paper-download",
    "carsi-papers",
    "chinese-academic"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "SECURITY.md",
    "cordis.patch.yml",
    "docs",
    "icon.svg",
    "index.js",
    "lib",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/run.mjs",
    "test:unit": "node test/run.mjs --unit",
    "test:kernel": "node test/kernel.mjs",
    "test:live": "node test/tools.mjs",
    "capture": "node test/capture.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cannotgetaname/dsh-carsi-papers.git"
  },
  "homepage": "https://github.com/cannotgetaname/dsh-carsi-papers#readme",
  "bugs": {
    "url": "https://github.com/cannotgetaname/dsh-carsi-papers/issues"
  }
}
